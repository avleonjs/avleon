{
  "name": "avleon-monorepo",
  "private": true,
  "description": "Source for @avleon/core, @avleon/cli and the Avleon docs site",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm ci && npm ci --prefix docs",
    "build": "lerna run build",
    "typecheck": "lerna run typecheck",
    "test": "lerna run test",
    "lint": "lerna run lint",
    "release": "lerna version",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "mirror": "bash scripts/mirror.sh",
    "prepare": "husky",
    "version": "node scripts/sync-peer-ranges.js"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "lint-staged": "^16.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
