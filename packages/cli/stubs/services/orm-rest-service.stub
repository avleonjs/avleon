import { AppService, InjectRepository } from '@avleon/core';
import { Repository } from 'typeorm';
import { {Model} } from '{modelImport}';

@AppService
export class {ClassName} {
  constructor(
    @InjectRepository({Model})
    private readonly {modelVar}Repository: Repository<{Model}>,
  ) {}

  async findAll(options: any = {}) {
    return this.{modelVar}Repository.find(options);
  }

  async paginate(current = 1, options: any = {}) {
    const take = 10;
    const skip = current > 1 ? (current - 1) * take : 0;
    const total = await this.{modelVar}Repository.count(options);
    const totalPage = Math.ceil(total / take);

    const data = await this.{modelVar}Repository.find({ ...options, take, skip });

    return {
      total,
      totalPage,
      current,
      next: current < totalPage ? current + 1 : null,
      prev: current > 1 ? current - 1 : null,
      data,
    };
  }

  async findByPk(id: number) {
    return this.{modelVar}Repository.findOneBy({ id } as any);
  }

  async findBy(options: any) {
    return this.{modelVar}Repository.findBy(options);
  }

  async findOneBy(options: any) {
    return this.{modelVar}Repository.findOneBy(options);
  }

  async create(createBody: Partial<{Model}>) {
    const newItem = this.{modelVar}Repository.create(createBody as any);
    return this.{modelVar}Repository.save(newItem);
  }

  async update(id: number, updateBody: Partial<{Model}>) {
    const result = await this.{modelVar}Repository.update({ id } as any, updateBody as any);
    return (result.affected ?? 0) > 0;
  }

  async delete(id: number) {
    const result = await this.{modelVar}Repository.delete({ id } as any);
    return (result.affected ?? 0) > 0;
  }
}
