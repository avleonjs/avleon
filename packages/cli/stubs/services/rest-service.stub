import { AppService, Collection } from '@avleon/core';
import { {Model} } from '{modelImport}';

@AppService
export class {ClassName} {
  private readonly {modelVar}Collection = Collection.from<{Model}>([]);

  async findAll() {
    return this.{modelVar}Collection.find();
  }

  async paginate(page = 1, take = 10) {
    const skip = page > 1 ? (page - 1) * take : 0;
    return this.{modelVar}Collection.paginate({ take, skip });
  }

  async findByPk(id: number) {
    return this.{modelVar}Collection.findOne((item) => item.id === id);
  }

  async create(createBody: Partial<{Model}>) {
    return this.{modelVar}Collection.add(createBody);
  }

  async update(id: number, updateBody: Partial<{Model}>) {
    this.{modelVar}Collection.update((item) => item.id === id, updateBody);
    return true;
  }

  async delete(id: number) {
    this.{modelVar}Collection.delete((item) => item.id === id);
    return true;
  }
}
